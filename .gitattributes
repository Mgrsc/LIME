# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Source code and scripts
*.kt text eol=lf
*.java text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.tsv text eol=lf
*.properties text eol=lf
gradlew text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.so binary
*.onnx binary
*.bin binary
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.ico binary
*.jks binary
*.keystore binary

# Generated baseline profiles (collapse large diffs in PR reviews)
app/src/release/generated/** linguist-generated=true
