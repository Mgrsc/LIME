# Template for release signing configuration
# Copy this file to keystore/keystore.properties and supply your actual keystore credentials.
# Note: keystore.properties and *.jks files are strictly ignored by git to protect private keys.

storeFile=keystore/release.jks
storePassword=your_store_password_here
keyAlias=your_key_alias_here
keyPassword=your_key_password_here
