<?xml version="1.0" encoding="utf-8"?>
<!-- Input method service declaration and subtypes -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:label="@string/app_name"
    android:settingsActivity="org.bitfennec.lime.ui.activity.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="true"
    android:supportsStylusHandwriting="true"
    tools:targetApi="33">
    <subtype
        android:label="@string/subtype_zh_cn"
        android:icon="@drawable/app_icon"
        android:languageTag="zh-CN"
        android:imeSubtypeLocale="zh_CN"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="AsciiCapable,EmojiCapable"
        android:overridesImplicitlyEnabledSubtype="true" />
    <subtype
        android:label="@string/subtype_en_us"
        android:icon="@drawable/app_icon"
        android:languageTag="en-US"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="AsciiCapable,EmojiCapable"
        android:overridesImplicitlyEnabledSubtype="false" />
</input-method>
