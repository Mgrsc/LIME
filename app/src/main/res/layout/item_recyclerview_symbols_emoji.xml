<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fl_symbols_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.emoji2.widget.EmojiTextView
        android:id="@+id/gv_symbols_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"/>
    <!-- yagni: 8sp half-width badge is visually constrained by compact keyboard key size -->
    <TextView
        android:id="@+id/tv_sdb_symbols_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="2dp"
        android:layout_marginTop="2dp"
        android:textSize="8sp"
        android:text="@string/symbol_half_width_badge"
        tools:ignore="SmallSp"
        android:visibility="gone"/>
</FrameLayout>