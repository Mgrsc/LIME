<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/app_icon"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textColor="@color/settings_primary_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/onboarding_app_tagline"
                android:textColor="@color/settings_secondary_text"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Step 1: Enable in system settings -->
        <LinearLayout
            android:id="@+id/card_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step1_title"
                android:textColor="@color/settings_primary_text"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/onboarding_step1_desc"
                android:textColor="@color/settings_secondary_text"
                android:textSize="12.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btn_step1_enable"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_step_button"
                    android:gravity="center"
                    android:text="@string/onboarding_step1_action"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:foreground="?android:attr/selectableItemBackground" />

                <LinearLayout
                    android:id="@+id/layout_step1_done"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_status_badge"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_menu_done"
                        app:tint="@color/settings_badge_active_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/onboarding_step1_done"
                        android:textColor="@color/settings_badge_active_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Step 2: Set as default IME -->
        <LinearLayout
            android:id="@+id/card_step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step2_title"
                android:textColor="@color/settings_primary_text"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/onboarding_step2_desc"
                android:textColor="@color/settings_secondary_text"
                android:textSize="12.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btn_step2_select"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_step_button"
                    android:gravity="center"
                    android:text="@string/onboarding_step2_action"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:foreground="?android:attr/selectableItemBackground" />

                <LinearLayout
                    android:id="@+id/layout_step2_done"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_status_badge"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_menu_done"
                        app:tint="@color/settings_badge_active_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/onboarding_step2_done"
                        android:textColor="@color/settings_badge_active_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Step 3: Test keyboard input -->
        <LinearLayout
            android:id="@+id/card_step3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step3_title"
                android:textColor="@color/settings_primary_text"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/onboarding_step3_desc"
                android:textColor="@color/settings_secondary_text"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/et_typing_sandbox"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sandbox_input"
                android:hint="@string/onboarding_sandbox_hint"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/settings_primary_text"
                android:textColorHint="@color/settings_secondary_text"
                android:textSize="14.5sp"
                android:importantForAutofill="no"
                android:inputType="text" />
        </LinearLayout>

        <!-- Bottom action button -->
        <TextView
            android:id="@+id/btn_start_using"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="@string/onboarding_btn_start"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:foreground="?android:attr/selectableItemBackground" />

        <!-- Privacy policy and offline security link -->
        <TextView
            android:id="@+id/tv_privacy_policy_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/onboarding_privacy_link"
            android:textColor="@color/settings_accent_color"
            android:textSize="12sp"
            android:foreground="?android:attr/selectableItemBackground"
            android:padding="6dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
